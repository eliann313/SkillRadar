{
    "$schema": "https://react.doctor/schema/config.json",
    "noScore": true,
    "blocking": "error",
    "categories": {
        "Performance": "warn"
    },
    "ignore": {
        "files": [".next/**", "out/**", "build/**", "coverage/**", "playwright-report/**"],
        "overrides": [
            // registerUserAction y requestPasswordResetAction DEBEN ser públicas (registro/recupero); protegidas por rate-limit + Zod + bcrypt. Verificado manual 2026-09-26.
            {
                "files": ["src/infrastructure/auth-actions.ts"],
                "rules": ["react-doctor/server-auth-actions"]
            },
            // Auth vía helpers que el scanner no reconoce: assertAdmin (admin), requireRecruiter (notes), checks inline + requireUser (thread/roadmap). Verificado manual 2026-09-26. Rutas actualizadas en refactor screaming/hexagonal (ADR-003).
            {
                "files": [
                    "src/features/admin/application/admin.use-cases.ts",
                    "src/features/application-notes/application/application-notes.use-cases.ts",
                    "src/features/contact-thread/application/contact-thread.use-cases.ts",
                    "src/features/roadmap/application/roadmap.use-cases.ts"
                ],
                "rules": ["react-doctor/server-auth-actions"]
            },
            // El timer de cv-upload-form se guarda y se limpia en el cleanup del efecto (clearTimeout verificado en el return del useEffect; el scanner no lo sigue dentro del handler). Verificado manual 2026-09-26, ruta actualizada en Fase 0 (movido a features). Re-verificado 2026-10-01.
            {
                "files": ["src/features/cv-analysis/presentation/cv-upload-form.tsx"],
                "rules": ["react-doctor/effect-needs-cleanup"]
            },
            // deleteUserApiKeyAction y getMyUsageAction verifican auth() + early return sin sesion + guest-guard antes de tocar DB (mismo patron que el resto del archivo). El scanner no reconoce el patron inline. Verificado manual Fase 1/5 (2026-10-01).
            {
                "files": ["src/app/[locale]/dashboard/settings/actions.ts"],
                "rules": ["react-doctor/server-auth-actions"]
            }
        ]
    },
    "serverAuthFunctionNames": [
        "assertAdmin",
        "assertActiveUser",
        "requireRecruiter",
        "requireUser",
        "requireVerifiedRecruiter"
    ]
}
