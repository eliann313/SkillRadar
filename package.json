        "db:status": "prisma migrate status",
        "arch": "depcruise src --config .dependency-cruiser.cjs",
        "knip": "knip",
        "postinstall": "prisma generate",
        "prepare": "husky",
        "hooks:install": "node scripts/githooks/install.mjs",
