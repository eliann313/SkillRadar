# ──────────────────────────────────────────────────────────────────────────────
# DATABASE & DATA LAYER
# ──────────────────────────────────────────────────────────────────────────────
# Neon PostgreSQL Connection String (with Connection Pooling enabled for Production)
# Locally, this can point to your local Docker container: postgresql://devuser:devpass@localhost:5432/platform_dev
DATABASE_URL="postgresql://devuser:devpass@localhost:5432/platform_dev"
# Connection string for direct connection (bypassing connection pooler, used by Prisma migrations)
DATABASE_URL_UNPOOLED=""

# ──────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY (Auth.js v5)
# ──────────────────────────────────────────────────────────────────────────────
# Run 'npx auth secret' or generate a secure 32-byte key for encryption
AUTH_SECRET="your-super-shared-secret-key"
NEXTAUTH_SECRET="your-super-shared-secret-key"

# AES-256-GCM Encryption key override (Used by src/lib/crypto.ts to encrypt LLM API Keys).
# If omitted, will fallback to AUTH_SECRET. Must be 32 bytes/characters in production.
ENCRYPTION_KEY="your-secure-32-character-crypto-key"

# GitHub OAuth Provider (Create a developer application on GitHub Settings)
# Callback URL for development: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth Provider (Create a developer project on Google Cloud Console)
# Callback URL for development: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────────────────────────────────────────────
# ARTIFICIAL INTELLIGENCE & LLM API KEYS
# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini API Key (Primary Provider - generous free tier)
GEMINI_API_KEY=""

# OpenRouter API Key (Manual Fallback Provider - e.g. Llama 3)
OPENROUTER_API_KEY=""

# Groq API Key (Ultra-fast Inference - generous free tier beta)
GROQ_API_KEY=""

# OpenAI API Key (GPT-6 Sol/Luna vía BYOK o global)
OPENAI_API_KEY=""

# Anthropic API Key (Claude Opus 5.5/Sonnet 5 vía BYOK o global)
ANTHROPIC_API_KEY=""

# Base URL pública (usada en emails, metadata y callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Guest demo: "true" para habilitar login demo (por defecto deshabilitado)
ENABLE_GUEST_LOGIN="false"

# Resend (emails transaccionales: reseteo de contraseña)
RESEND_API_KEY=""

# Secreto del cron de expiración de ofertas (vercel.json)
CRON_SECRET=""

# ──────────────────────────────────────────────────────────────────────────────
# FILE STORAGE (Vercel Blob)
# ──────────────────────────────────────────────────────────────────────────────
# Token de lectura/escritura del store de Blob.
# Se obtiene en el dashboard de Vercel: Storage → Create → Blob → Connect (.env.local),
# o con `vercel env pull`. Sin este token la subida de CVs por archivo no funciona
# (el formulario sigue aceptando pegado de texto como fallback).
BLOB_READ_WRITE_TOKEN=""
# ID del store (lo agrega Vercel al conectar el store; el SDK lo usa para OIDC).
# Opcional en local si usás el token de arriba.
BLOB_STORE_ID=""

# ──────────────────────────────────────────────────────────────────────────────
# GITHUB API (opcional: mayor rate-limit en análisis de GitHub)
# ──────────────────────────────────────────────────────────────────────────────
# Token personal de GitHub (sin scopes necesarios para repos públicos).
# Sin él se usa la API pública con límite anónimo reducido.
GITHUB_PERSONAL_ACCESS_TOKEN=""

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE & DATA LAYER (flags)
# ──────────────────────────────────────────────────────────────────────────────
# "false" para forzar conexión directa sin WebSockets de Neon (ej. Docker local)
USE_NEON_WEBSOCKETS="true"

# ──────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS (públicas: visibles en el cliente)
# ──────────────────────────────────────────────────────────────────────────────
# "true" para desactivar el polling de notificaciones en el dashboard
NEXT_PUBLIC_DISABLE_NOTIFICATIONS="false"

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: RATE LIMITING (Upstash Redis)
# ──────────────────────────────────────────────────────────────────────────────
# Required if you implement the sliding-window rate limiter in Server Actions
UPSTASH_REDIS_REST_URL=""
# Upstash REST Token for serverless access
UPSTASH_REDIS_REST_TOKEN=""
