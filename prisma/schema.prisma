datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth v5 Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("developer")
  passwordHash  String?   @db.Text
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  isSuspended   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  
  // SkillRadar custom relations
  resumes           Resume[]
  jobMatches        JobMatch[]
  githubAnalyses    GithubAnalysis[]
  interviewSessions InterviewSession[]
  receivedRequests  ContactRequest[]   @relation("DeveloperRequests")
  sentRequests      ContactRequest[]   @relation("RecruiterRequests")
  shortlists        Shortlist[]        @relation("RecruiterShortlists")
  shortlistedBy     Shortlist[]        @relation("DeveloperShortlists")
  jobApplications   JobApplication[]
  notifications     Notification[]
  jobPostings       JobPosting[]       @relation("RecruiterJobPostings")
  jobPostingApplications JobPostingApplication[] @relation("DeveloperApplications")
  reports           ContentReport[]    @relation("UserReports")
  candidateNotes    CandidateNote[]    @relation("RecruiterNotes")
  interviewScorecards InterviewScorecard[] @relation("RecruiterScorecards")
  outreachTemplates OutreachTemplate[]
  roadmapTasks      RoadmapTask[]
  savedSearches     SavedSearch[]
  contactMessages   ContactMessage[]
  linkedinAudits    LinkedInAudit[]

  // Claves de API Personales (Cifradas con AES-256-GCM)
  geminiApiKey       String?   @db.Text
  groqApiKey         String?   @db.Text
  openrouterApiKey   String?   @db.Text
  openaiApiKey       String?   @db.Text
  anthropicApiKey    String?   @db.Text
  
  // Preferencias de Inferencia
  defaultAiProvider  String    @default("gemini") // "gemini" | "groq" | "openrouter" | "openai" | "anthropic"
  defaultAiModel     String    @default("gemini-3.8-flash")

  // Perfil Público Compartible
  isPublicProfile    Boolean   @default(false)
  publicUsername     String?   @unique
  showSkills         Boolean   @default(true)
  showGithub         Boolean   @default(true)
  showSeniority      Boolean   @default(true)

  // Preferencias de Notificaciones por Email
  emailNotifications            Boolean   @default(true)
  emailNewApplication           Boolean   @default(true)
  emailApplicationStatusChanged Boolean   @default(true)
  emailContactUpdates           Boolean   @default(true)
  emailJobMatches               Boolean   @default(true)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// SkillRadar Custom Models
model Resume {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  fileUrl     String
  rawText     String   @db.Text
  atsScore    Int?
  analysis    Json?    // { keywords: [], missingKeywords: [], formatIssues: [], strengths: [], improvements: [], estimatedSeniority: "" }
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobMatches  JobMatch[]
  jobPostingApplications JobPostingApplication[]
  jobPostingMatches      JobPostingMatchCache[]
}

model JobMatch {
  id           String   @id @default(cuid())
  userId       String
  resumeId     String?
  jobOfferText String   @db.Text
  matchScore   Int?
  analysis     Json?    // { requiredSkills: [], missingSkills: [], seniority: "", recommendations: [] }
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume       Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
}

model GithubAnalysis {
  id           String   @id @default(cuid())
  userId       String
  githubUser   String
  profileScore Int?
  languages    Json?    // { TypeScript: 45, Python: 30, ... }
  repos        Json?    // Array of repo summaries
  activity     Json?    // commits/week, streak, etc
  analysis     Json?    // { strengths: [], weaknesses: [], suggestions: [] }
  createdAt    DateTime @default(now())

  // 18.1: Developer Intelligence Engine — Seniority Signals
  commitFrequency    String?  // "daily" | "weekly" | "sporadic" | "inactive"
  readmeQualityScore Int?     // 0-100
  longestStreakDays  Int?
  topRepoTopics      Json?    // string[]
  senioritySignals   Json?    // string[] — qualitative evidence detected by AI
  detectedPatterns   Json?    // { hasCI, hasTesting, hasDocker, hasAuthImplementation, hasCaching, hasObservability }

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id         String   @id @default(cuid())
  userId     String
  resumeId   String?
  jobMatchId String?
  company    String?
  jobPostingId String?
  score      Int?     // Calificación global promedio (0-100)
  debrief    Json?    // Calificaciones estructuradas y feedback cualitativo
  messages   Json     // Historial de la conversación [{ role: "user" | "assistant", content: "" }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactRequest {
  id          String   @id @default(cuid())
  recruiterId String
  developerId String
  message     String   @db.Text
  status      String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recruiter   User     @relation("RecruiterRequests", fields: [recruiterId], references: [id], onDelete: Cascade)
  developer   User     @relation("DeveloperRequests", fields: [developerId], references: [id], onDelete: Cascade)
  messages    ContactMessage[]
}

model Shortlist {
  id          String   @id @default(cuid())
  recruiterId String
  developerId String
  createdAt   DateTime @default(now())

  recruiter   User     @relation("RecruiterShortlists", fields: [recruiterId], references: [id], onDelete: Cascade)
  developer   User     @relation("DeveloperShortlists", fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, developerId])
}

model JobApplication {
  id        String   @id @default(cuid())
  userId    String
  title     String
  company   String
  url       String?
  status    String   @default("to_apply") // "to_apply" | "applied" | "interviewing" | "offer"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "new_job_match" | "new_application" | "application_status_changed"
  title     String
  message   String
  link      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id             String   @id @default(cuid())
  recruiterId    String
  title          String
  company        String
  location       String
  remoteType     String   // "remote" | "hybrid" | "onsite"
  description    String   @db.Text
  requiredSkills Json     // array de strings
  seniorityLevel String
  status         String   @default("draft") // "draft" | "published" | "closed" | "under_review"
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recruiter      User                    @relation("RecruiterJobPostings", fields: [recruiterId], references: [id], onDelete: Cascade)
  applications   JobPostingApplication[]
  matches        JobPostingMatchCache[]
}

model JobPostingApplication {
  id           String   @id @default(cuid())
  jobPostingId String
  developerId  String
  resumeId     String?
  status       String   @default("submitted") // "submitted" | "reviewed" | "rejected" | "shortlisted"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobPosting  JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  developer   User       @relation("DeveloperApplications", fields: [developerId], references: [id], onDelete: Cascade)
  resume      Resume?    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  notes       CandidateNote[]
  scorecard   InterviewScorecard?

  @@unique([jobPostingId, developerId])
}

model JobPostingMatchCache {
  id           String   @id @default(cuid())
  resumeId     String
  jobPostingId String
  matchScore   Int
  analysis     Json     // Contenido idéntico a JobMatchAnalysis
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resume       Resume     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jobPostingId])
}

model ContentReport {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String   // "job_posting" | "contact_request"
  targetId    String
  reason      String
  status      String   @default("pending") // "pending" | "reviewed" | "dismissed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter    User     @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String   // cv_uploaded, job_match_completed, public_profile_viewed, contact_request_sent, job_posting_applied, user_registered
  userHash  String?  // Hash SHA-256 del userId para agrupar conversiones sin revelar PII
  createdAt DateTime @default(now())
}

// Stack-1: notas internas del recruiter por postulación
model CandidateNote {
  id            String   @id @default(cuid())
  applicationId String
  recruiterId   String
  body          String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application   JobPostingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter     User     @relation("RecruiterNotes", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Stack-1: scorecards de entrevista persistidos por postulación
model InterviewScorecard {
  id            String   @id @default(cuid())
  applicationId String   @unique
  recruiterId   String
  developerId   String
  jobPostingId  String
  criteria      Json     // [{ question, score 1-5, note }]
  overall       Int      // promedio 0-100
  comment       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application   JobPostingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter     User     @relation("RecruiterScorecards", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([jobPostingId])
}

// Stack-1: templates de outreach del recruiter
model OutreachTemplate {
  id          String   @id @default(cuid())
  recruiterId String
  name        String
  subject     String?
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recruiter   User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
}

// Stack-1: checklist accionable de cierre de brechas del developer
model RoadmapTask {
  id        String   @id @default(cuid())
  userId    String
  skill     String
  step      String
  done      Boolean  @default(false)
  source    String   @default("manual") // "manual" | "job_match" | "copilot"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Stack-1: búsquedas guardadas (pool recruiter + job board dev)
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  scope     String   @default("talent_pool") // "talent_pool" | "job_board"
  filters   Json     // { query, seniority[], minScore, sort }
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Stack-1: thread de mensajes dentro de un ContactRequest
model ContactMessage {
  id        String   @id @default(cuid())
  requestId String
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  request   ContactRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// Stack-1: auditorías LinkedIn persistidas
model LinkedInAudit {
  id        String   @id @default(cuid())
  userId    String
  scores    Json     // { seo, headline, about, experience }
  suggestions Json   // array de sugerencias con ejemplos
  checklist Json?    // checklist SEO
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
